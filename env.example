# Copied to .env by ./setup.sh - edit .env, not this file.

# Where books and downloads live (needs room - a few GB to start).
DATA_DIR=./data

# Your user/group IDs (run `id`) and timezone. setup.sh fills these in.
PUID=1000
PGID=1000
TZ=America/New_York

# The address people open for Books. setup.sh fills in this machine's LAN IP.
BOOKS_URL=http://192.168.1.10:8083
# true only if you put this behind HTTPS (reverse proxy / Cloudflare Tunnel).
HTTPS=false
BOOK_LANGUAGE=en

# VPN for downloads (WireGuard). Get the key + address from your provider's
# WireGuard config download. Provider names: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
VPN_SERVER_COUNTRIES=

# Uncomment to also run Audiobookshelf (http://<host>:13378).
#COMPOSE_PROFILES=audiobooks
